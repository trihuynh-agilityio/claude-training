{
  "permissions": {
    "allow": [
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh label create *)",
      "Bash(gh label list *)",
      "Bash(gh api repos/trihuynh-agilityio/claude-training/issues/*)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git fetch github*)",
      "Bash(npm ci *)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(uv run pytest*)",
      "Bash(*/.claude/scripts/check-task.sh *)",
      "Bash(.claude/scripts/check-task.sh *)"
    ],
    "deny": [
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * dev)",
      "Bash(git push * main)",
      "Bash(git push * +dev)",
      "Bash(git push * +main)",
      "Bash(git push * *:dev)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/dev)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * refs/heads/dev)",
      "Bash(git push * refs/heads/main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-forbidden-command.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-push-outside-feat.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/next-phase.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-on-finish.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
